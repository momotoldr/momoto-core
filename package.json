{
  "name": "momoto-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Momoto Photobooth backend \u2014 Socket.io signaling + synchronization server.",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "_comment:db": "db:migrate and db:studio layer .env.local over .env so they hit the LOCAL database \u2014 the Prisma CLI reads only .env on its own, which would silently target the remote one. db:deploy stays bare: it runs where the platform injects real env vars and no .env file exists.",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/prisma/build/index.js studio",
    "_comment:envfiles": "The :staging / :production variants point a script at a REMOTE environment. `--env-file` turns those values into real environment variables before the process starts, so they beat both .env and .env.local (dotenv never overrides what is already set) \u2014 which is what makes the target explicit rather than whatever .env happens to hold. Any other script can be aimed the same way: node --env-file=.env.staging --import tsx scripts/<name>.ts",
    "db:deploy:staging": "node --env-file=.env.staging node_modules/prisma/build/index.js migrate deploy",
    "db:studio:staging": "node --env-file=.env.staging node_modules/prisma/build/index.js studio",
    "seed:testers:staging": "node --env-file=.env.staging --import tsx scripts/seedTesters.ts",
    "make-admin:staging": "node --env-file=.env.staging --import tsx scripts/makeAdmin.ts",
    "make-admin": "tsx scripts/makeAdmin.ts",
    "seed:testers": "tsx scripts/seedTesters.ts",
    "purge:strips": "tsx scripts/purgeStrips.ts",
    "send:invites": "tsx scripts/sendInvites.ts",
    "backfill:strips": "tsx scripts/backfillStripStorage.ts",
    "backfill:avatars": "tsx scripts/backfillAvatarStorage.ts",
    "check:r2": "tsx scripts/checkR2.ts",
    "postinstall": "prisma generate",
    "reset:password": "tsx scripts/resetPassword.ts",
    "backfill:emails": "tsx scripts/backfillEmails.ts",
    "check:notify": "tsx scripts/checkNotify.ts",
    "import:regions": "tsx scripts/importRegions.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "midtrans-client": "^1.4.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.5",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "prisma": "^6.19.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.6.0"
  }
}
