{
  "name": "momoto-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Momoto Photobooth backend — Socket.io signaling + synchronization server.",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "_comment:db": "db:migrate and db:studio layer .env.local over .env so they hit the LOCAL database — the Prisma CLI reads only .env on its own, which would silently target the remote one. db:deploy stays bare: it runs where the platform injects real env vars and no .env file exists.",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/prisma/build/index.js studio",
    "make-admin": "tsx scripts/makeAdmin.ts",
    "seed:testers": "tsx scripts/seedTesters.ts",
    "purge:strips": "tsx scripts/purgeStrips.ts",
    "send:invites": "tsx scripts/sendInvites.ts",
    "send:reminders": "tsx scripts/sendReminders.ts",
    "_comment:reminders": "send:reminders:prod is the one to use. --env-file makes .env real environment variables before the process starts, so they beat BOTH env files (loadEnv's dotenv never overrides what is already set). Without it, .env.local's empty NOTIFY_URL/NOTIFY_API_KEY lines win and every send is a silent no-op against a localhost database.",
    "send:reminders:prod": "node --env-file=.env --import tsx scripts/sendReminders.ts",
    "backfill:strips": "tsx scripts/backfillStripStorage.ts",
    "backfill:avatars": "tsx scripts/backfillAvatarStorage.ts",
    "check:r2": "tsx scripts/checkR2.ts",
    "postinstall": "prisma generate",
    "reset:password": "tsx scripts/resetPassword.ts",
    "backfill:emails": "tsx scripts/backfillEmails.ts",
    "check:notify": "tsx scripts/checkNotify.ts",
    "import:regions": "tsx scripts/importRegions.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "midtrans-client": "^1.4.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.5",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "prisma": "^6.19.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.6.0"
  }
}
