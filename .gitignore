node_modules/
dist/
# Every env file except the template. `.env.staging` / `.env.production` hold real
# remote credentials — a DATABASE_URL, JWT_SECRET and R2 keys — so the deny-list has to
# be by pattern, not by name: adding one more file must never be the thing that leaks.
.env
.env.*
!.env.example
*.log
.DS_Store

# SQLite dev database (Prisma). Migrations under prisma/migrations/ ARE committed.
*.db
*.db-journal
prisma/dev.db*

# Operator working files: tester lists and the credentials they produce. These hold
# real email addresses and live passwords — never commit them.
testers*.txt
testers*.csv
invites*.csv
test-invite*.csv
*.credentials.csv
*.sent.log
*.preview.html

# Local Claude Code permissions — per machine, not project config.
.claude/settings.local.json
