# ─────────────────────────────────────────────────────────────────────────────
# Two files are read, in precedence order (see src/config/env.ts):
#   1. `.env.local`  — optional, gitignored, THIS MACHINE ONLY. Wins over `.env`.
#   2. `.env`        — everything else.
# A real environment variable (what the platform injects) beats both.
#
# Put anything that must not touch shared infrastructure — a local DATABASE_URL,
# sandbox payment keys — in `.env.local`. The `db:migrate` / `db:studio` scripts
# layer the same two files, because the Prisma CLI reads only `.env` on its own
# and would otherwise target whatever `.env` points at.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP port the server listens on.
PORT=3001

# How many reverse proxies sit in front of this server (Express `trust proxy`).
# This decides which address `req.ip` resolves to, and every per-IP rate limit
# depends on it being right:
#   1 = a single platform proxy (Railway on its own). The default.
#   2 = that platform behind a *proxying* Cloudflare record (orange cloud).
#   0 = no proxy (running the server directly).
# Too low and every user shares one bucket; too high and a client can forge
# X-Forwarded-For to get unlimited buckets. Confirm after deploy by logging req.ip.
TRUST_PROXY=1

# Comma-separated allowlist of frontend origins permitted via CORS.
# Use your real deploy origin(s) in production; localhost for dev.
# Includes the operator portal (momoto-portal) — dev default :5174 (:5175 is a
# fallback in case 5174 is taken).
# Example: https://app.example.com,https://admin.example.com,https://example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── Database (Prisma) ──────────────────────────────────────────────────────
# Postgres in every environment (see prisma/schema.prisma — the provider is a
# literal, so dev and prod can't differ). Locally: a native install, a Docker
# container, or a free hosted dev branch. In production this is a SECRET — load it
# from the platform's secret store, never commit a real connection string.
# TODO: Securely load this value from an environment variable or secrets vault. Do not hardcode.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/momoto?schema=public"

# ── Auth ───────────────────────────────────────────────────────────────────
# Secret used to sign access JWTs. REQUIRED. momoto-realtime verifies these tokens on
# the socket handshake, so its JWT_SECRET must be set to exactly the same value. Generate a strong random value
# (e.g. `openssl rand -base64 48`) and load it from the environment / a secrets
# vault in production. Never commit a real secret.
JWT_SECRET=[REDACTED_JWT_SECRET]
# Access-token lifetime, in seconds (default 3600 = 1 hour). Expiry is recovered
# transparently via the refresh token, so this mainly bounds how long a stolen
# access token stays usable.
JWT_ACCESS_TTL=3600
# Refresh-token lifetime, in seconds (default 604800 = 7 days). This is the
# "stay signed in" window; a shorter value bounds how long a session (or an
# un-revoked token from an offline logout) stays valid, at the cost of signing
# idle users out sooner.
JWT_REFRESH_TTL=604800
# Google OAuth client id (Google Cloud console → Credentials). Must match the
# frontend's VITE_GOOGLE_CLIENT_ID. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
# Set true in production (HTTPS) so the refresh cookie is marked Secure.
COOKIE_SECURE=false

# ── Moved to momoto-realtime ─────────────────────────────────────────────────
# Session timing (SESSION_DURATION_MS, START_DELAY_MS), room capacity (ROOM_CAPACITY,
# ROOM_CAPACITY_MAX, ROOMS_MAX_ACTIVE), REDIS_URL and every STUN/TURN variable now
# configure momoto-realtime — see its .env.example. Setting them here does nothing.

# ── Payments (Midtrans Snap) ─────────────────────────────────────────────────
# Charges users to unlock a strip's clean (watermark-free) download/print. Payment
# endpoints are DISABLED until both keys below are set, so local dev runs without them.
# Get keys from the Midtrans dashboard (use Sandbox keys for testing).
# MIDTRANS_SERVER_KEY=[REDACTED_MIDTRANS_SERVER_KEY]
# MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
#
# Hit Midtrans production (vs sandbox). Leave unset/false for sandbox.
# MIDTRANS_IS_PRODUCTION=false
# Channels the Snap popup offers, in display order. Unset = every channel active on the
# merchant account. Each must also be activated in the dashboard for the environment
# being hit (sandbox has everything on; production only what Midtrans has approved).
# MIDTRANS_ENABLED_PAYMENTS=gopay,shopeepay,qris
#
# Price to unlock one strip's download/print, in whole rupiah (default 8999 = Rp8.999).
# STRIP_PRINT_PRICE_IDR=8999
# How many *unpaid* strips one user may keep. Paid strips are exempt. Over the cap,
# POST /strips answers 409 cart_full. Keep equal to the frontend's
# VITE_STRIP_MAX_ITEMS, which bounds the signed-out browser cache.
# STRIP_MAX_ITEMS=5
# How many *paid* strips the gallery holds. Over the cap, an unlock (POST /strips/unlock
# or POST /payments/checkout) answers 409 gallery_full — nothing already unlocked is ever
# auto-removed, and a full gallery never blocks saving a new strip to the cart.
# GALLERY_MAX_ITEMS=25
#
# Note: set the Payment Notification URL in the Midtrans dashboard to
# https://<your-api-host>/payments/midtrans/notification (use a tunnel in dev).

# ── Object storage (Cloudflare R2) ───────────────────────────────────────────
# Where strip images live. A composed strip is a 1–3 MB PNG and a user keeps
# several, so serving them out of Postgres meant every <img> render was a
# multi-megabyte read buffered whole in this process — and the blobs rode along in
# every database backup. With R2 configured, new strips are written to a bucket and
# the row keeps only a key.
#
# REQUIRED to save strips. The in-database `bytes` fallback was dropped once every
# image had moved, so without R2 the upload routes answer 503 storage_unavailable
# (reads and the rest of the API keep working). Uploaded AVATARS also go here, but
# they keep their in-database fallback — without R2 an avatar upload still works, it
# just lands in Postgres. For local work without a Cloudflare account, point
# R2_ENDPOINT at MinIO. A half-filled config fails at startup rather than failing
# quietly later.
#
# Cloudflare dashboard → R2 → Manage API tokens → Create.
#   - Pick an ACCOUNT API token, not a User one: a user token dies if that person is
#     removed from the Cloudflare account, breaking every strip save.
#   - Permission "Object Read & Write" (not Admin — the backend never manages buckets).
#   - Scope it to the two buckets below rather than all of them.
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY are SECRETS — never commit real values.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
#
# THREE buckets. The first two hold the strip copies, which have opposite access
# rules; the third keeps avatars separate from both:
#   R2_BUCKET       — the watermarked strips and their thumbnails. Same exposure the
#                     /strips/:id endpoint always had (unauthenticated, guarded by an
#                     unguessable key), so this one may be public.
#   R2_PRINT_BUCKET — the clean, paid copies. Must NOT be public: these are always
#                     streamed through the auth + payment gate.
# R2_BUCKET=momoto-strips
# R2_PRINT_BUCKET=momoto-strips-print
#
# A THIRD bucket, holding uploaded avatars. Required whenever R2 is enabled: there is
# no fallback, because the alternative — quietly writing avatars into R2_BUCKET —
# is what this replaced, and it would put them somewhere you didn't ask for and
# wouldn't think to look. Must NOT be R2_PRINT_BUCKET; avatars are unauthenticated.
# A stored avatar is a bare key with no record of its bucket, so changing this
# strands every avatar already written — pick it once.
# R2_AVATAR_BUCKET=momoto-avatars
#
# Public origin for R2_AVATAR_BUCKET. A custom domain maps to exactly ONE bucket, so
# this cannot borrow R2_PUBLIC_BASE_URL — that origin serves R2_BUCKET, which the
# avatars are not in. Leaving it unset is a valid choice: avatars then stream through
# the API instead of off the CDN.
# R2_AVATAR_PUBLIC_BASE_URL=https://avatars.example.com
#
# Public origin for R2_BUCKET. Origin only — no trailing slash, no path. When set, the
# API hands out CDN URLs and image loads never reach this server; that is where the
# render-latency win comes from. Setting this REQUIRES R2_PRINT_BUCKET, since it makes
# R2_BUCKET world-readable.
#
# Use a CUSTOM DOMAIN (Bucket → Settings → Custom Domains → Add). The bucket's
# "Public Development URL" (the pub-xxxx.r2.dev one) is rate-limited, documented as
# non-production, and gets NO Cloudflare caching — which defeats the purpose here.
# It's fine for a local trial run.
# R2_PUBLIC_BASE_URL=https://strips.example.com
#
# Override the S3 endpoint (defaults to https://<account-id>.r2.cloudflarestorage.com).
# Point this at MinIO or similar to test the storage path locally.
# R2_ENDPOINT=

# ── Closed beta ───────────────────────────────────────────────────────────────
# `true` refuses self-service signup, so the only accounts in existence are the ones
# seeded with `npm run seed:testers`. Hiding the frontend's /register route is not
# enough on its own — these endpoints are reachable directly with curl, so the flag is
# what actually closes them.
#
# Covers both doors:
#   POST /auth/register  → 403 registration_closed
#   POST /auth/google    → 403 registration_closed for an identity it doesn't already
#                          know. An account that is already Google-linked still signs
#                          in, so nobody gets locked out of an existing account.
# INVITE_ONLY=true

# ── Notification service (momoto-notify) ─────────────────────────────────────
# This app no longer holds SMTP credentials — every outbound email goes through
# momoto-notify, which owns the transport and all four templates. See its README.
#
# Leave NOTIFY_URL unset in local development: the client then logs the message it
# would have sent, link included, so verification and reset stay testable without
# running a second process or a mailbox.
# NOTIFY_URL=http://localhost:3002
#
# Must match momoto-notify's NOTIFY_API_KEY. Sent as `Authorization: Bearer <key>`.
# Setting NOTIFY_URL without this warns at boot: an open send endpoint is a spam relay.
# NOTIFY_API_KEY=

# Public origin of the FRONTEND, used to build the links we mail. Defaults to the first
# CORS_ORIGINS entry. Never derived from a request's Host header: an attacker who can
# set that header would otherwise get us to mail a victim a link to their own server
# with the victim's single-use token in it.
# APP_BASE_URL=https://momotoldr.com

# How long an address-confirmation link stays good (hours). Default 24.
# EMAIL_VERIFY_TTL_HOURS=24

# How long a password-reset link stays good (minutes). Default 30 — much shorter than a
# confirmation link, because this one can take over the account and it sits in an inbox.
# PASSWORD_RESET_TTL_MINUTES=30
